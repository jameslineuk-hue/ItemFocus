SUPABASE_URL=https://your-project.supabase.co
# Backend secret from Settings → API Keys (not the browser-safe publishable key).
# Prefer the platform secret key (sb_secret_...) or legacy JWT service_role (eyJ...).
# Never use sb_publishable_... here. This app reads SUPABASE_SERVICE_ROLE_KEY only (not SUPABASE_KEY).
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Optional: enables /api/admin/* and the Manage tags / Edit pages. Use a long random string; send as Authorization: Bearer … or X-Admin-Key.
# ADMIN_SECRET=generate-a-long-random-secret
